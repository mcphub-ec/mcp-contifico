# ─── Contifico MCP Server ──────────────────────────────────────────────────────
# Copia este archivo como .env y completa los valores REALES antes de usar.
#   cp .env.example .env && chmod 600 .env
# ─────────────────────────────────────────────────────────────────────────────

# API Key de Contifico (sección Integraciones del panel).
# En producción multi-tenant NO se usa: cada request envía su propia key vía
# 'Authorization: Bearer <key>'. Solo aplica en dev local (ver ALLOW_ENV_KEY_FALLBACK).
CONTIFICO_API_KEY=

# Token del Punto de Venta (POS). Requerido para crear/modificar documentos.
CONTIFICO_POS_TOKEN=

# (Opcional) URL base de la API. No modificar salvo indicación de Contifico.
# CONTIFICO_BASE_URL=https://api.contifico.com/sistema

# (Opcional) Timeout HTTP en segundos.
# CONTIFICO_HTTP_TIMEOUT=30

# Transporte. Usa http_stream (default): transporta el header Authorization por
# cada tool call — requisito del modelo multi-tenant por request. (sse | http_stream)
MCP_TRANSPORT_MODE=http_stream
MCP_PORT=8000

# ─── Seguridad (defaults seguros) ─────────────────────────────────────────────
# Fallback a CONTIFICO_API_KEY cuando NO llega el header Authorization.
# Déjalo en false en producción (multi-tenant): un request sin header se RECHAZA,
# nunca reusa la key del servidor (evita acceso cruzado entre tenants).
# Ponlo en true SOLO para dev local single-tenant.
ALLOW_ENV_KEY_FALLBACK=false

# Modo solo-lectura: bloquea operaciones de escritura (POST/PUT/DELETE) a nivel
# servidor. Déjalo en true hasta tener una capa de aprobación humana.
CONTIFICO_READONLY=true
